# TaskPro Environment Configuration
SECRET_KEY=django-insecure-taskpro-jwt-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL)
# Set your MySQL credentials below:
DB_ENGINE=mysql
DB_NAME=taskpro_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to True to allow fallback to SQLite if MySQL is unreachable
DB_FALLBACK_SQLITE=True
